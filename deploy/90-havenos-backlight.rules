# Lets the havenOS service (group video) set the display's backlight. The kernel creates brightness and bl_power
# owned by root; this hands them to the video group. Installed by deploy/install.sh into /etc/udev/rules.d/.
SUBSYSTEM=="backlight", ACTION=="add|change", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power"
